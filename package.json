{
  "name": "kagazai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"blue,green\" \"npm run dev --workspace=apps/server\" \"npm run dev --workspace=apps/web\"",
    "build": "npm run build --workspaces",
    "start": "concurrently -n \"server,web\" -c \"blue,green\" \"npm run start --workspace=apps/server\" \"npm run start --workspace=apps/web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
