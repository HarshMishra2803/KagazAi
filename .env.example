# KagazAi Environment Configuration Reference
# See apps/server/.env.example and apps/web/.env.example for app-specific variables

# Server configuration (apps/server/.env)
# PORT=5001
# HOCUSPOCUS_PORT=1234
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kagazai?retryWrites=true&w=majority
# CLIENT_URL=http://localhost:3000
# JWT_SECRET=your_jwt_secret_min_32_characters
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Web configuration (apps/web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:5001
# NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
